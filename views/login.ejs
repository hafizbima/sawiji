<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Login — Sawiji Pilates</title>
<link rel="stylesheet" href="/style.css">
</head>
<body class="login-page">
  <form method="post" action="/login" class="login-form">
    <h1>Sawiji Pilates</h1>
    <p class="subtitle">Dashboard Manajemen Kelas</p>
    <% if (locals.error) { %><p class="error"><%= error %></p><% } %>
    <input type="password" name="password" placeholder="Masukkan password" required autofocus>
    <button type="submit">Masuk</button>
  </form>
</body>
</html>